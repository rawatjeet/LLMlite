# Copy this file to `.env` and fill in your real values.
# `.env` is in .gitignore — never commit it.

# At least ONE of these is required.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default LLM (LiteLLM-style names: provider/model)
# Examples:
#   gemini/gemini-1.5-flash       (free tier)
#   gemini/gemini-2.0-flash-lite
#   openai/gpt-4o
#   openai/gpt-4o-mini
DEFAULT_MODEL=gemini/gemini-1.5-flash

# Generation defaults (used by improved/agent scripts)
DEFAULT_MAX_TOKENS=1024
DEFAULT_MAX_ITERATIONS=10
DEFAULT_TEMPERATURE=0.0
DEFAULT_TOP_P=1.0
DEFAULT_RETRIES=3
DEFAULT_BASE_SLEEP=1.0

# Caching (used by quasi-agent)
LLM_CACHE_DIR=.llm_cache

# RAG agent index cache (agent_rag.py)
RAG_CACHE_DIR=.rag_cache

# Persistent sessions (used by conversational/resume agents)
SESSION_DIR=.agent_sessions
RESUME_SESSION_DIR=.resume_sessions
RESUME_OUTPUT_DIR=resumes_output

# Job seeker agent
JOBS_DB_PATH=.job_search/jobs_database.json
APPLICATIONS_PATH=.job_search/applications.json
COVER_LETTERS_DIR=.job_search/cover_letters
